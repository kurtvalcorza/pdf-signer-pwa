<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- R5, FR-004: no network permission, and no library manifest may merge one back in.
         The only permission left after merging is androidx.core's own signature-level
         DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION (C1, spike S3). -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- R10, FR-013: allowBackup=false alone does not stop device-to-device transfer on
         API 31+; dataExtractionRules does. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PDFSigner"
        tools:targetApi="31">

        <!-- R6: per-app opt-outs for what the WebView provider itself sends. Crash reports
             follow the device setting and are disclosed, not claimed away. -->
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />
        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />

        <!-- C4: the launcher is the only exported component. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- R8: camera capture target only; not exported, per-URI grants. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="io.github.kurtvalcorza.pdfsigner.capture"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- C4, spike S3: profileinstaller's exported receiver (guarded by DUMP) is removed. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
    </application>

</manifest>
